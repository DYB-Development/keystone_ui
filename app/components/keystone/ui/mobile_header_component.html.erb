<div class="lg:hidden">
  <%= link_to @back_url, class: BACK_LINK_CLASSES, aria: { label: "Back" } do %>
    <%= BACK_ICON.html_safe %>
  <% end %>
</div>
<span class="<%= TITLE_CLASSES %>">
  <%= @title %>
  <% if @subtitle.present? %>
    <span class="block text-xs font-normal text-gray-500 dark:text-gray-400 truncate"><%= @subtitle %></span>
  <% end %>
</span>
