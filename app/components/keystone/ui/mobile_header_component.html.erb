<div class="<%= ROW_CLASSES %>">
  <div class="<%= WRAPPER_CLASSES %>">
    <% if @back_url %>
      <%= link_to @back_url, class: BACK_LINK_CLASSES, aria: { label: "Back" } do %>
        <%= BACK_ICON.html_safe %>
      <% end %>
    <% end %>
  </div>
  <span class="<%= TITLE_CLASSES %>">
    <% if @overline.present? %>
      <span class="<%= OVERLINE_CLASSES %>"><%= @overline %></span>
    <% end %>
    <%= @title %>
    <% if @subtitle.present? %>
      <span class="<%= SUBTITLE_CLASSES %>"><%= @subtitle %></span>
    <% end %>
  </span>
  <% if @badge %>
    <%= render Keystone::Ui::BadgeComponent.new(**@badge, class: BADGE_CLASSES) %>
  <% end %>
</div>
