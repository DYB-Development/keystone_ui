<div class="<%= WRAPPER_CLASSES %>">
  <% if @back_url %>
    <%= link_to @back_url, class: BACK_LINK_CLASSES, aria: { label: "Back" } do %>
      <%= BACK_ICON.html_safe %>
    <% end %>
  <% end %>
</div>
<span class="<%= TITLE_CLASSES %>">
  <%= @title %>
  <% if @subtitle.present? %>
    <span class="<%= SUBTITLE_CLASSES %>"><%= @subtitle %></span>
  <% end %>
</span>
