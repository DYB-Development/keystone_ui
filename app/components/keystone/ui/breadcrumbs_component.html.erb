<nav aria-label="Breadcrumb" class="<%= CLASSES %>">
  <% @trail.each_with_index do |(label, href), index| %>
    <% if index.positive? %>
      <span aria-hidden="true"><%= SEPARATOR %></span>
    <% end %>
    <%= link_to label, href %>
  <% end %>
  <% if @current %>
    <% if @trail.any? %>
      <span aria-hidden="true"><%= SEPARATOR %></span>
    <% end %>
    <span aria-current="page"><%= @current %></span>
  <% end %>
</nav>
