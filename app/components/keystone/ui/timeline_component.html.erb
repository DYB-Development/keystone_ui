<div class="flex flex-col gap-3">
  <% rows.each do |row| %>
    <div data-timeline-row>
      <div class="<%= ROW_TEXT_CLASSES %>">
        <span data-timeline-label><%= row[:label] %></span>
        <span data-timeline-duration><%= duration(row) %></span>
      </div>
      <div class="<%= TRACK_CLASSES %>">
        <% row[:tries].each do |entry| %>
          <div class="<%= bar_classes(entry) %>" data-timeline-bar style="<%= bar_style(entry) %>"></div>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="<%= AXIS_CLASSES %>">
    <span data-timeline-axis-start><%= axis_start_label %></span>
    <span data-timeline-axis-end><%= total_duration %></span>
  </div>
</div>
