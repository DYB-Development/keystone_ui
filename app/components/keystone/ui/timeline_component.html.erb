<div>
  <% entries.each do |entry| %>
    <div data-timeline-row>
      <span data-timeline-label><%= entry[:label] %></span>
      <span data-timeline-duration><%= duration(entry) %></span>
      <div class="<%= TRACK_CLASSES %>">
        <div class="absolute" data-timeline-bar style="<%= bar_style(entry) %>"></div>
      </div>
    </div>
  <% end %>
  <div class="flex justify-between">
    <span data-timeline-axis-start><%= axis_start_label %></span>
    <span data-timeline-axis-end><%= total_duration %></span>
  </div>
</div>
