<%= form_with url: @url, method: @method do %>
  <% if @note %>
    <label><span class="ks-label"><%= @note[:label] %></span><%= render Keystone::Ui::InputComponent.new(name: @note[:name], placeholder: @note[:placeholder]) %></label>
  <% end %>
  <%= render Keystone::Ui::ButtonRowComponent.new do %>
    <% @actions.each do |action| %>
      <%= render Keystone::Ui::ButtonComponent.new(variant: :secondary, **action) %>
    <% end %>
  <% end %>
<% end %>
