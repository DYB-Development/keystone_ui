<%= form_with url: @url, method: @method, class: form_classes do %>
  <div class="<%= bar_classes %>">
    <% if @note %>
      <label class="<%= note_classes %>"><span class="<%= NOTE_LABEL_CLASSES %>"><%= @note[:label] %></span><%= render Keystone::Ui::InputComponent.new(name: @note[:name], placeholder: @note[:placeholder]) %></label>
    <% end %>
    <%= buttons %>
  </div>
  <% if @hint %>
    <p class="<%= hint_classes %>"><%= @hint %></p>
  <% end %>
<% end %>
<div class="<%= SPACER_CLASSES %>" data-decision-bar-spacer inert>
  <div class="<%= bar_classes %> <%= BAR_COPY_CLASSES %>"><%= buttons %></div>
  <div class="<%= TAB_BAR_ROOM_CLASSES %>"></div>
</div>
