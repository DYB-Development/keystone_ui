<%= form_with url: @url, method: @method, class: FORM_CLASSES do %>
  <div class="<%= BAR_CLASSES %>">
    <% if @note %>
      <label class="<%= NOTE_CLASSES %>"><span class="ks-label"><%= @note[:label] %></span><%= render Keystone::Ui::InputComponent.new(name: @note[:name], placeholder: @note[:placeholder]) %></label>
    <% end %>
    <%= render Keystone::Ui::ButtonRowComponent.new(equal_width: :phone) do %>
      <% @actions.each do |action| %>
        <%= render Keystone::Ui::ButtonComponent.new(variant: :secondary, **action) %>
      <% end %>
    <% end %>
    <div class="<%= PRIMARY_CLASSES %>"><%= render Keystone::Ui::ButtonComponent.new(**@primary) %></div>
  </div>
  <% if @hint %>
    <p class="<%= HINT_CLASSES %>"><%= @hint %></p>
  <% end %>
<% end %>
