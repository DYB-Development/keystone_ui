<% if link_tabs? %>
<% tab_row = capture do %>
<nav class="<%= classes %>">
  <% tabs.each do |tab| %>
    <a href="<%= tab[:href] %>" data-turbo-action="replace" class="<%= tab[:current] ? tab_classes : TAB_BASE_CLASSES %>"<% if tab[:current] %> aria-current="page" data-active<% end %>><%= tab[:label] %></a>
  <% end %>
</nav>
<% end %>
<% if summary? %>
<div>
  <div class="<%= SUMMARY_CLASSES %>"><%= summary %></div>
  <%= tab_row %>
  <div class="<%= CONTENT_CLASSES %>"><%= content %></div>
</div>
<% else %>
<%= tab_row %>
<%= content %>
<% end %>
<% else %>
<div data-controller="tab-switcher">
  <div class="<%= classes %>">
    <% tabs.each_with_index do |tab, index| %>
      <button
        type="button"
        class="<%= tab_classes %>"
        data-tab-switcher-target="tab"
        data-action="click->tab-switcher#select"
        data-index="<%= index %>"
        <%= "data-active" if index == 0 %>><%= tab %></button>
    <% end %>
  </div>
  <%= content %>
</div>
<% end %>
