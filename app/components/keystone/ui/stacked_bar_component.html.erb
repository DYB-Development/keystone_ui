<div>
  <div class="<%= BAR_CLASSES %>">
    <% drawn_segments.each do |segment| %>
      <div class="<%= segment_classes(segment) %>" style="flex: <%= size(segment) %> 1 0%" tabindex="0" role="img" aria-label="<%= spoken(segment) %>">
        <span class="<%= amount_classes(segment) %>" aria-hidden="true"><%= shown_amount(segment) %></span>
        <span class="<%= tip_classes(segment) %>" aria-hidden="true"><span class="<%= TIP_NAME_CLASSES %>"><%= segment[:label] %></span><span class="<%= TIP_VALUE_CLASSES %>"><%= shown_amount(segment) %></span><span class="<%= TIP_NAME_CLASSES %>"><%= share(segment) %></span></span>
      </div>
    <% end %>
  </div>
  <ul class="<%= LEGEND_CLASSES %>">
    <% segments.each do |segment| %>
      <li class="<%= LEGEND_ITEM_CLASSES %>"><span class="<%= swatch_classes(segment) %>" aria-hidden="true"></span><span><%= segment[:label] %></span><span class="<%= LEGEND_VALUE_CLASSES %>"><%= shown_amount(segment) %></span></li>
    <% end %>
  </ul>
</div>
