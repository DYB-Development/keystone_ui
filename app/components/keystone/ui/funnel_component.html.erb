<% if joined? %>
  <div class="<%= JOINED_CLASSES %>">
    <% layers.each do |layer| %>
      <% if layer.conversion_percent %>
        <div></div>
        <div class="<%= BAND_ROW_CLASSES %>">
          <div class="<%= BAND_CLASSES %>"></div>
          <div class="<%= BAND_LABEL_ROW_CLASSES %>"><span class="<%= BAND_LABEL_CLASSES %>"><%= layer.conversion_percent %>%</span></div>
        </div>
      <% end %>
      <div class="<%= WORDS_CLASSES %>">
        <span class="<%= value_classes %>"><%= layer.value %></span>
        <span class="<%= label_classes %>"><%= layer.label %></span>
      </div>
      <div></div>
    <% end %>
  </div>
<% else %>
  <div class="<%= container_classes %>">
    <% layers.each do |layer| %>
      <% if layer.conversion_percent %>
        <div class="<%= transition_classes %>">↓ <%= layer.conversion_percent %>%</div>
      <% end %>
      <div class="<%= layer_classes %>">
        <div class="<%= row_classes %>">
          <span class="<%= label_classes %>"><%= layer.label %></span>
          <span class="<%= value_classes %>"><%= layer.value %></span>
        </div>
        <div class="<%= bar_classes %> <%= layer.color_classes %>" style="width: <%= layer.width_percent %>%"></div>
      </div>
    <% end %>
  </div>
<% end %>
