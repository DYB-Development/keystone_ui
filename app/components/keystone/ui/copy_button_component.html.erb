<button
  type="button"
  class="<%= classes %>"
  data-controller="clipboard"
  data-action="click->clipboard#copy"
  data-clipboard-text="<%= text %>"
  data-clipboard-success-message-value="<%= success_message %>"
  data-clipboard-error-message-value="<%= error_message %>">
  <%= copy_icon.html_safe %>
  <%= label %>
</button>
