<% if grouped? %>
  <div class="<%= GROUP_CLASSES %>">
    <% if prefix %><span class="<%= ADDON_CLASSES %>"><%= prefix %></span><% end %>
    <%= tag.input(**tag_options) %>
    <% if suffix %><span class="<%= ADDON_CLASSES %>"><%= suffix %></span><% end %>
  </div>
<% else %>
  <%= tag.input(**tag_options) %>
<% end %>
