<div class="ks-value-list">
  <% rows.each do |row| %>
    <%= link_to row.fetch(:href), **row_options(row) do %>
      <span class="<%= STACK_CLASSES %>">
        <span class="<%= TEXT_CLASSES %>">
          <% if row[:top_line] %>
            <span class="<%= TOP_LINE_CLASSES %>">
              <% if row[:top_line][:type] %>
                <span class="<%= TOP_LINE_TYPE_CLASSES %>"><span class="<%= type_tone_classes(row) %>"><%= row[:top_line][:type][:label] %></span></span>
              <% else %>
                <%= render top_line_badge(row) %>
              <% end %>
              <span class="<%= TOP_LINE_TEXT_CLASSES %>"><%= row[:top_line][:text] %></span>
            </span>
          <% end %>
          <span class="<%= LABEL_CLASSES %>"><%= row.fetch(:label) %></span>
          <% if row[:subtitle] %>
            <span class="<%= SUBTITLE_CLASSES %>"><%= row[:subtitle] %></span>
          <% end %>
        </span>
        <% if row[:badge] %>
          <%= render badge(row) %>
        <% end %>
      </span>
      <% if row[:value] %>
        <span class="<%= VALUE_CLASSES %>"><%= row[:value] %></span>
      <% end %>
      <% if chevron %>
        <%= Keystone::Ui::SettingsLinkComponent::CHEVRON_ICON.html_safe %>
      <% end %>
    <% end %>
  <% end %>
</div>
