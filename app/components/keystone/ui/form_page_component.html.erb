<% content_for :form_page, true %>
<% content_for :form_page_title, @title %>
<% content_for :form_page_back_url, @back_url %>

<% if @trail %>
  <% content_for :keystone_back_navigation, render(Keystone::Ui::BreadcrumbsComponent.new(trail: @trail, current: @title)) %>
<% else %>
  <% content_for :keystone_back_navigation, render(Keystone::Ui::DesktopBackLinkComponent.new(url: @back_url)) %>
<% end %>

<div class="<%= DESKTOP_WRAPPER_CLASSES %>">
  <h1 class="<%= TITLE_CLASSES %>"><%= @title %></h1>
  <% if subtitle? %>
    <p class="<%= SUBTITLE_CLASSES %>"><%= @subtitle %></p>
  <% end %>
</div>
