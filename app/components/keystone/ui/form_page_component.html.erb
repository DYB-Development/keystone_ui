<% content_for :form_page, true %>
<% content_for :form_page_title, @title %>
<% content_for :form_page_back_url, @back_url %>

<% unless top_level? %>
  <% content_for :keystone_page_header, render(Keystone::Ui::DesktopBackLinkComponent.new(url: @back_url)) %>
<% end %>
<% if @trail&.any? %>
  <% content_for :keystone_page_header, render(Keystone::Ui::BreadcrumbsComponent.new(trail: @trail, current: @title)) %>
<% end %>

<% content_for :keystone_page_header do %>
  <div class="<%= DESKTOP_WRAPPER_CLASSES %>">
    <h1 class="<%= TITLE_CLASSES %>"><%= @title %></h1>
    <% if subtitle? %>
      <p class="<%= SUBTITLE_CLASSES %>"><%= @subtitle %></p>
    <% end %>
  </div>
<% end %>
