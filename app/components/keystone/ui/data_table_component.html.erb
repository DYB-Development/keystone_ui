<% if column_picker %>
  <div class="<%= Keystone::Ui::DataTableComponent::TOOLBAR_CLASSES %>">
    <%= render column_picker %>
  </div>
<% end %>
<div class="<%= Keystone::Ui::DataTableComponent::WRAPPER_CLASSES %>">
  <table class="<%= table_classes %> divide-y divide-gray-300 dark:divide-white/15">
    <thead class="<%= head_classes %>">
      <tr>
        <% header_cells.each do |cell| %>
          <th scope="<%= cell[:scope] %>" class="<%= cell[:classes] %>">
            <% if cell[:sort_href] %>
              <a href="<%= cell[:sort_href] %>" class="<%= Keystone::Ui::DataTableComponent::SORT_LINK_CLASSES %>" data-turbo-action="replace">
                <%= cell[:label] %>
                <% if cell[:sort_active] %>
                  <span class="<%= Keystone::Ui::DataTableComponent::SORT_ICON_CLASSES %> <%= Keystone::Ui::DataTableComponent::SORT_ICON_ACTIVE %>"><%= (cell[:sort_direction] == :asc ? Keystone::Ui::DataTableComponent::SORT_ASC_ICON : Keystone::Ui::DataTableComponent::SORT_DESC_ICON).html_safe %></span>
                <% else %>
                  <span class="<%= Keystone::Ui::DataTableComponent::SORT_ICON_CLASSES %> <%= Keystone::Ui::DataTableComponent::SORT_ICON_INACTIVE %>"><%= Keystone::Ui::DataTableComponent::SORT_NEUTRAL_ICON.html_safe %></span>
                <% end %>
              </a>
            <% else %>
              <%= cell[:label] %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody class="<%= body_classes %>"<% if row_detail? %> data-controller="row-detail" data-action="turbo:before-morph-attribute->row-detail#keep"<% end %>>
      <% if empty? %>
        <% if @empty_message %>
          <tr>
            <td class="<%= Keystone::Ui::DataTableComponent::EMPTY_CELL_CLASSES %>" colspan="<%= column_count %>">
              <%= @empty_message %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <% @items.each_with_index do |item, idx| %>
          <% if (group = group_starting_at(idx)) %>
            <tr class="<%= summary_row_classes %>" data-table-group>
              <% group_cells(group).each do |cell| %>
                <th scope="colgroup" class="<%= cell[:classes] %>"><% if cell[:label] %><span class="<%= Keystone::Ui::DataTableComponent::CELL_LABEL_CLASSES %>"><%= cell[:label] %></span><% end %><%= cell[:value] %></th>
              <% end %>
              <% if actions? %><th></th><% end %>
            </tr>
          <% end %>
          <% detail = capture(item, &@row_detail_block) if row_detail? %>
          <tr<% if (classes = row_classes(idx)) %> class="<%= classes %>"<% end %><% if current_row?(idx) %> aria-current="true"<% end %><% if detail.present? %> data-action="click->row-detail#toggle"<% end %>>
            <% row_cells[idx].each_with_index do |cell, cell_index| %>
              <td class="<%= cell[:classes] %>">
                <% if cell[:label] %>
                  <span class="<%= Keystone::Ui::DataTableComponent::CELL_LABEL_CLASSES %>"><%= cell[:label] %></span>
                <% end %>
                <% if detail.present? && cell_index.zero? %>
                  <button type="button" class="<%= Keystone::Ui::DataTableComponent::DETAIL_BUTTON_CLASSES %>" aria-label="Show detail" aria-expanded="false" aria-controls="<%= row_detail_id(idx) %>" data-row-detail-target="toggle"><%= Keystone::Ui::DisclosureComponent::CARET_ICON.html_safe %></button>
                <% end %>
                <% if cell[:href] %>
                  <a href="<%= cell[:href] %>"><%= cell[:value] %></a>
                <% else %>
                  <%= cell[:value] %>
                <% end %>
              </td>
            <% end %>
            <% if actions? %>
              <td class="<%= actions_cell_classes %>">
                <% row_actions = capture(item, &@actions_block) %>
                <% if row_actions.present? %>
                  <%= render Keystone::Ui::ActionMenuComponent.new do %>
                    <%= row_actions %>
                  <% end %>
                <% end %>
              </td>
            <% end %>
          </tr>
          <% if detail.present? %>
            <tr id="<%= row_detail_id(idx) %>"<% if phone_list_block_classes %> class="<%= phone_list_block_classes %>"<% end %> hidden data-row-detail-target="detail">
              <td<% if phone_list_block_classes %> class="<%= phone_list_block_classes %>"<% end %> colspan="<%= column_count %>"><%= detail %></td>
            </tr>
          <% end %>
        <% end %>
      <% end %>
    </tbody>
    <% if total_cells.any? %>
      <tfoot class="<%= summary_row_classes %>">
        <tr<% if phone_list_block_classes %> class="<%= phone_list_block_classes %>"<% end %>>
          <% total_cells.each do |cell| %>
            <th scope="row" class="<%= cell[:classes] %>"><% if cell[:label] %><span class="<%= Keystone::Ui::DataTableComponent::CELL_LABEL_CLASSES %>"><%= cell[:label] %></span><% end %><%= cell[:value] %></th>
          <% end %>
          <% if actions? %><th></th><% end %>
        </tr>
      </tfoot>
    <% end %>
  </table>
</div>
