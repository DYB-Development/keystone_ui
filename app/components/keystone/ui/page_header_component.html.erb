<% content_for :mobile_page_title, @title %>
<% if action_url %>
  <% content_for :mobile_action_url, action_url %>
  <% content_for :mobile_action_label, action_label %>
  <% content_for :mobile_action_method, action_method.to_s if action_method %>
<% end %>
<div class="<%= wrapper_classes %>">
  <div>
    <% if badges? %>
      <div class="<%= TITLE_ROW_CLASSES %>">
        <h1 class="<%= title_classes %>"><%= @title %></h1>
        <% @badges.each do |badge| %>
          <%= render Keystone::Ui::BadgeComponent.new(**badge) %>
        <% end %>
      </div>
    <% else %>
      <h1 class="<%= title_classes %>"><%= @title %></h1>
    <% end %>
    <% if subtitle? %>
      <p class="<%= SUBTITLE_CLASSES %>"><%= subtitle_text %></p>
    <% end %>
  </div>
  <% if actions? %>
    <div class="<%= actions_classes %>">
      <% if action? %>
        <%= @action_block.call %>
      <% elsif action_url %>
        <%= render Keystone::Ui::ButtonComponent.new(label: action_label, href: action_url, method: action_method || :get, confirm: action_confirm) %>
      <% end %>
      <% if menu? %>
        <%= render Keystone::Ui::ActionMenuComponent.new do %>
          <% @menu.each do |item| %>
            <%= render Keystone::Ui::ActionMenuItemComponent.new(**item) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
