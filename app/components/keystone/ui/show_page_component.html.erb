<% content_for :show_page, true %>
<% content_for :show_page_title, @title %>
<% content_for :show_page_back_url, @back_url %>
<% content_for :show_page_subtitle, @subtitle if @subtitle.present? %>

<% if @trail %>
  <% content_for :keystone_page_header, render(Keystone::Ui::BreadcrumbsComponent.new(trail: @trail, current: @title)) %>
<% else %>
  <% content_for :keystone_page_header, render(Keystone::Ui::DesktopBackLinkComponent.new(url: @back_url)) %>
<% end %>
