<div class="<%= classes %>">
  <% if header? %>
    <div class="<%= HEADER_CLASSES %>">
      <div>
        <h2 class="<%= TITLE_CLASSES %>"><%= @title %></h2>
        <% if @subtitle %>
          <p class="<%= SUBTITLE_CLASSES %>"><%= @subtitle %></p>
        <% end %>
      </div>
      <% if @action %>
        <a href="<%= @action[:href] %>" class="<%= action_classes %>">
          <%= @action[:label] %>
        </a>
      <% end %>
      <% if @menu.any? %>
        <%= render Keystone::Ui::ActionMenuComponent.new do %>
          <% @menu.each do |item| %>
            <%= render Keystone::Ui::ActionMenuItemComponent.new(**item) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <%= content %>
</div>
