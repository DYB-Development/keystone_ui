<div class="<%= classes %>">
  <% if header? %>
    <div class="<%= header_classes %>">
      <div class="<%= TITLE_WRAPPER_CLASSES %>">
        <h2 class="<%= title_classes %>"><%= @title %></h2>
        <% if @subtitle %>
          <p class="<%= SUBTITLE_CLASSES %>"><%= @subtitle %></p>
        <% end %>
      </div>
      <% if aside? %>
        <div class="<%= ASIDE_CLASSES %>"><%= aside %></div>
      <% end %>
      <% if @action || @menu.any? %>
        <div class="<%= ACTIONS_CLASSES %>">
          <% if @action %>
            <a href="<%= @action[:href] %>" class="<%= action_classes %>">
              <%= @action[:label] %>
            </a>
          <% end %>
          <% if @menu.any? %>
            <%= render Keystone::Ui::ActionMenuComponent.new do %>
              <% @menu.each do |item| %>
                <%= render Keystone::Ui::ActionMenuItemComponent.new(**item) %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= content %>
</div>
