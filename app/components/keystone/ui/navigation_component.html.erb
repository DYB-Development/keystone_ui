<% if !anything_to_show? %>
<%= content %>
<% elsif sidebar? %>
<% sidebar = capture do %>
  <nav class="<%= SIDEBAR_CLASSES %>">
    <% if logo? %>
      <div><%= logo %></div>
    <% end %>
    <% groups.each do |group, tabs| %>
      <div class="<%= SIDEBAR_GROUP_CLASSES %>">
        <p class="<%= sidebar_group_label_classes(tabs) %>"><%= group.label %></p>
        <% tabs.each do |tab| %>
          <a class="<%= sidebar_tab_classes(tab) %>" href="<%= tab.href_for(helpers) %>"><%= tab.label %></a>
        <% end %>
      </div>
    <% end %>
    <% if menus? %>
      <div class="<%= SIDEBAR_MENUS_CLASSES %>"><%= menus %></div>
    <% end %>
  </nav>
<% end %>
<div class="<%= SIDEBAR_ROW_CLASSES %>">
  <%= sidebar if sidebar_first? %>
  <div class="<%= SIDEBAR_CONTENT_CLASSES %>"><%= content %></div>
  <%= sidebar unless sidebar_first? %>
</div>
<% else %>
<div class="<%= TOP_BAR_CLASSES %>">
<%= render Keystone::Ui::NavbarComponent.new(sticky: false) do |navbar| %>
  <% if logo? %>
    <% navbar.with_logo do %><%= logo %><% end %>
  <% end %>
  <% navbar.with_desktop_links do %>
    <% groups.each do |group, tabs| %>
      <%= render Keystone::Ui::NavDropdownComponent.new(title: group.label, area: group.label, active: holds_current?(tabs)) do %>
        <% tabs.each do |tab| %>
          <%= render Keystone::Ui::NavItemComponent.new(label: tab.label, href: tab.href_for(helpers), active: current?(tab)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% if menus? %>
    <% navbar.with_desktop_right do %><%= menus %><% end %>
  <% end %>
<% end %>
</div>
<%= content %>
<% end %>
